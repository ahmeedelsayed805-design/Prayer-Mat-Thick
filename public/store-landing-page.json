/4] rounded-xl overflow-hidden bg-slate-100 relative\">\n            <img id=\"hero-main-img\" src=\"https://ais-pre-ts5axkesjombi5mkolod5c-185137071279.europe-west3.run.app/assets/aistudio/image_7c2ab4e4.png\" alt=\"سجادة الصلاة الطبية\" class=\"w-full h-full object-cover\">\n            <div class=\"absolute bottom-0 inset-x-0 bg-black/60 text-white p-2 text-center text-xs\">\n              <span id=\"hero-model-title\" class=\"font-bold\">الأخضر الملكي (نقشة الكعبة المشرفة)</span>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 4. المشكلة والحل -->\n  <section class=\"py-12 bg-white px-4 border-y border-slate-100\">\n    <div class=\"max-w-4xl mx-auto\">\n      <div class=\"text-center mb-8\">\n        <span class=\"text-xs font-bold text-rose-600 bg-rose-50 px-3 py-1 rounded-full border border-rose-200\">المشكلة والحل</span>\n        <h2 class=\"text-xl sm:text-3xl font-extrabold text-slate-900 mt-2\">هل تعاني من ألم الركبتين والمفاصل أثناء الصلاة؟</h2>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        <div class=\"bg-rose-50/40 border border-rose-200 rounded-2xl p-5\">\n          <h3 class=\"text-rose-900 font-bold text-base mb-3 flex items-center gap-1.5\">\n            <span>❌ السجاد العادي الخفيف:</span>\n          </h3>\n          <ul class=\"text-xs sm:text-sm text-slate-700 space-y-2.5\">\n            <li>• ضغط قاسي من السيراميك والباركيه على غضاريف الركبتين.</li>\n            <li>• تنميل وألم في أسفل الظهر والكاحل أثناء التشهد.</li>\n            <li>• انزلاق السجادة وتحركها المستمر على الأرض.</li>\n            <li>• تشتت الذهن وفقدان الخشوع بسبب الألم الجسدي.</li>\n          </ul>\n        </div>\n\n        <div class=\"bg-emerald-50/60 border-2 border-emerald-500 rounded-2xl p-5\">\n          <h3 class=\"text-emerald-900 font-bold text-base mb-3 flex items-center gap-1.5\">\n            <span>✅ سجادتنا الطبية الفاخرة:</span>\n          </h3>\n          <ul class=\"text-xs sm:text-sm text-slate-800 space-y-2.5\">\n            <li>• إسفنج طبي مرن (سُمك 1.5 سم) يمتص وزن الجسم بالكامل.</li>\n            <li>• راحة فورية وإمكانية إطالة السجود والدعاء دون ألم.</li>\n            <li>• قاعدة محكمة مانعة للانزلاق على كل أنواع الأرضيات.</li>\n            <li>• مقاس واسع (115 × 65 سم) وملمس مخملي ناعم كالحرير.</li>\n          </ul>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 5. فيديو حقيقي من أرض الواقع -->\n  <section id=\"real-video\" class=\"py-12 px-4 bg-[#FAF9F5]\">\n    <div class=\"max-w-3xl mx-auto text-center\">\n      <span class=\"text-xs font-bold text-emerald-800 bg-emerald-100 px-3 py-1 rounded-full\">تصوير حقيقي 100%</span>\n      <h2 class=\"text-xl sm:text-3xl font-black text-slate-900 mt-2\">شاهد بالفيديو سماكة التبطين وجودة التقفيل</h2>\n      <p class=\"text-xs sm:text-sm text-slate-600 mt-1 mb-6\">فيديو يوضح سماكة الإسفنج الحقيقي والشريط الأبيض المقوى والبطانة السفلية</p>\n\n      <div class=\"max-w-xs mx-auto rounded-2xl overflow-hidden shadow-xl border-4 border-white bg-black aspect-[9/16]\">\n        <video controls playsinline class=\"w-full h-full object-cover\">\n          <source src=\"https://ais-pre-ts5axkesjombi5mkolod5c-185137071279.europe-west3.run.app/assets/aistudio/WhatsApp_Video_2026-10-04_at_8.15.33_PM_7ded4565.mp4\" type=\"video/mp4\">\n          متصفحك لا يدعم تشغيل الفيديو\n        </video>\n      </div>\n    </div>\n  </section>\n\n  <!-- 6. تقييمات العملاء (المحادثات الحقيقية فقط) -->\n  <section class=\"py-12 px-4 bg-white border-t border-slate-100\">\n    <div class=\"max-w-4xl mx-auto\">\n      <div class=\"text-center mb-8\">\n        <span class=\"text-xs font-bold text-amber-800 bg-amber-50 px-3 py-1 rounded-full border border-amber-200\">آراء وتجارب حقيقية</span>\n        <h2 class=\"text-xl sm:text-3xl font-black text-slate-900 mt-2\">تقييمات عملائنا الحقيقية فور استلام الشحنات</h2>\n      </div>\n\n      <div class=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        <div class=\"bg-slate-900 text-white p-4 rounded-2xl border border-slate-800\">\n          <div class=\"text-xs font-bold text-emerald-400 mb-2\">محادثة واتساب موثقة بعد استلام الأوردر ⭐⭐⭐⭐⭐</div>\n          <div class=\"rounded-xl overflow-hidden bg-black/40 p-1 mb-3\">\n            <img src=\"https://ais-pre-ts5axkesjombi5mkolod5c-185137071279.europe-west3.run.app/assets/aistudio/image_ae09cfc9.png\" alt=\"تقييم عميل\" class=\"w-full h-auto max-h-72 object-contain mx-auto\">\n          </div>\n          <p class=\"text-amber-300 font-bold text-sm\">\"اه الاوردر تحفه تسلم ايدك جميل جداا ❤️\"</p>\n        </div>\n\n        <div class=\"bg-slate-900 text-white p-4 rounded-2xl border border-slate-800\">\n          <div class=\"text-xs font-bold text-emerald-400 mb-2\">محادثة حقيقية - طلب للأهل ⭐⭐⭐⭐⭐</div>\n          <div class=\"rounded-xl overflow-hidden bg-black/40 p-1 mb-3\">\n            <img src=\"https://ais-pre-ts5axkesjombi5mkolod5c-185137071279.europe-west3.run.app/assets/aistudio/image_99dc8f02.png\" alt=\"تقييم عميل\" class=\"w-full h-auto max-h-72 object-contain mx-auto\">\n          </div>\n          <p class=\"text-amber-300 font-bold text-sm\">\"جميل اوي تسلم يدك ❤️ عجب اختي شديد وانا كمان عجبني\"</p>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- 7. المواصفات الفنية والمقاسات -->\n  <section class=\"py-12 px-4 bg-[#FAF9F5] border-t border-slate-100\">\n    <div class=\"max-w-4xl mx-auto text-center\">\n      <span class=\"text-xs font-bold text-emerald-900 bg-emerald-100 px-3 py-1 rounded-full\">المواصفات القياسية</span>\n      <h2 class=\"text-xl sm:text-3xl font-black text-slate-900 mt-2 mb-6\">أبعاد مدروسة لراحة تامة (115 × 65 سم)</h2>\n\n      <div class=\"grid grid-cols-3 gap-3 max-w-lg mx-auto mb-6 text-center\">\n        <div class=\"bg-white p-3 rounded-xl border border-slate-200\">\n          <div class=\"text-xl font-black text-emerald-800\">115 سم</div>\n          <p class=\"text-xs text-slate-500 font-bold mt-1\">الط